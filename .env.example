# 쌤보드(옛 이름 자비스) 설정. 이 파일을 .env 로 복사한 뒤 값을 채웁니다.  cp .env.example .env
# .env 는 저장소에 올리지 않습니다(.gitignore).

# ── 접속 주소 ────────────────────────────────────────────────
# 브라우저가 접속하는 주소(끝에 / 없음). Google OAuth 리디렉션 주소와 쿠키 Secure 여부가 여기서 정해집니다.
# 이 컴퓨터에서만 쓰면 http://localhost:3000, 바깥에서 쓰려면 반드시 https 주소(Cloudflare Tunnel 또는 Caddy).
PUBLIC_URL=http://localhost:3000
PORT=3000
# docker compose 가 이 서버에 여는 포트(127.0.0.1 전용). 3000 이 이미 쓰이면 3010 등으로 바꿉니다.
APP_PORT=3000

# ── 데이터베이스 ─────────────────────────────────────────────
# docker compose 로 띄우면 DATABASE_URL 은 자동으로 만들어지므로 비밀번호만 정하면 됩니다.
POSTGRES_PASSWORD=여기에-긴-무작위-값
# Docker 없이 직접 실행할 때만 씁니다.
# DATABASE_URL=postgres://jarvis:비밀번호@localhost:5432/jarvis
# 개발용 DB(npm run dev:db)를 쓸 때:
# DATABASE_URL=postgres://jarvis:jarvis@127.0.0.1:54329/jarvis

# ── 암호화 마스터 키 ─────────────────────────────────────────
# API 키·커넥터 토큰을 AES-256-GCM 으로 암호화하는 키입니다.  만들기: openssl rand -base64 32
# 이 값을 잃으면 저장한 API 키와 Google 연결을 다시 등록해야 합니다. DB 백업과 다른 곳에 따로 보관하세요.
MASTER_KEY=

# ── 로그인 ───────────────────────────────────────────────────
# password: 처음 접속할 때 설치 코드로 주인 계정(이메일·암호)을 만든다(기본, Google 설정 없이 바로 쓸 수 있음).
# google:   아래 허용 목록의 Google 계정으로 로그인한다(GOOGLE_CLIENT_ID·SECRET 필요).
# 비워 두면 GOOGLE_CLIENT_ID 가 있을 때 google, 없으면 password. 어느 쪽이든 로그인한 뒤 PIN 을 넣어야 보드가 열린다.
LOGIN_MODE=password
# 처음 주인 계정을 만들 때 넣는 설치 코드(scripts/install.sh 가 만든다). 계정을 만든 뒤에는 쓰이지 않는다.
SETUP_CODE=
# google 방식일 때 로그인을 허용할 Google 계정(쉼표로 구분).
ALLOWED_EMAILS=
# Google 로그인 또는 Google 시트·설문 연결을 쓸 때만 채웁니다.
# Google Cloud 콘솔 → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID(웹 애플리케이션)
#   승인된 리디렉션 URI:
#     ${PUBLIC_URL}/api/auth/google/callback        (google 로그인일 때)
#     ${PUBLIC_URL}/api/connectors/google/callback  (시트·설문 연결)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 자동 로그인 기간(일). 마지막으로 쓴 날부터 이 기간이 지나야 다시 로그인을 묻는다(쓰는 동안 계속 늘어남).
SESSION_DAYS=30

# ── Google 시트 연결(쓰지 않으면 비워 둡니다) ─────────────────
# Google Picker 용 브라우저 API 키(HTTP 리퍼러를 PUBLIC_URL 로 제한)와 프로젝트 번호.
GOOGLE_PICKER_API_KEY=
GOOGLE_APP_ID=

# ── 그 밖 ────────────────────────────────────────────────────
# 알림·시트 동기화·휴지통 정리를 맡는 워커. 서버를 여러 대 띄울 때 한 대만 true 로 둡니다.
WORKER_ENABLED=true
# Cloudflare Tunnel 을 쓸 때의 터널 토큰(docker compose --profile tunnel)
TUNNEL_TOKEN=
# Caddy 를 쓸 때의 도메인(docker compose --profile caddy)
CADDY_DOMAIN=

# ── 백업(scripts/backup.sh) ──────────────────────────────────
# 덤프를 암호화할 암호. 마스터 키와 다른 값으로, 백업과 다른 곳에 보관합니다.
BACKUP_PASSPHRASE=
# 백업이 실패했을 때 알림 센터로 알리려면 설정 → 연결에서 만든 웹훅 주소와 서명 키를 넣습니다.
BACKUP_WEBHOOK_URL=
BACKUP_WEBHOOK_SECRET=
