{
  "name": "@jarvis/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "bin": {
    "jarvis": "dist/cli/jarvis.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noCheck",
    "dev": "tsc -p tsconfig.json --noCheck --watch --preserveWatchOutput",
    "dev:run": "node --watch --env-file=../../.env dist/main.js",
    "start": "node dist/main.js",
    "migrate": "node --env-file=../../.env dist/cli/jarvis.js migrate",
    "reset-pin": "node --env-file=../../.env dist/cli/jarvis.js reset-pin",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "node --env-file=../../.env dist/cli/jarvis.js"
  },
  "dependencies": {
    "@jarvis/shared": "0.1.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "google-auth-library": "^9.15.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10"
  }
}
